node_modules/
__pycache__/
.DS_Store
.vercel/

# Build output. `npm run build` regenerates all of it, and Vercel builds it on
# deploy, so none of it belongs in history.
public/

# The MediaPipe runtime for camera control: every file is either an unmodified
# upstream release or a build product, so it is fetched rather than stored.
#   npm run assets:mediapipe
assets/mediapipe/

# Inputs to the asset pipeline in tools/. Around 260 MB of third-party binaries
# that would sit in git history forever; the packed results in assets/ are what
# the game actually loads, and tools/optimize-*.mjs rebuild them.
#   Kenney city kits (CC0)      https://kenney.nl/assets
#   Quaternius trees (CC0)      https://quaternius.com
#   Meshy and Mixamo exports    generated per-project, see CREDITS.md
tools/source-art/
tools/node_modules/
tools/models/

# Stale scratch directories left over from the pre-restructure layout. They
# hold only screenshots, logs and one-off check scripts -- everything the asset
# pipeline still needs was moved to tools/source-art/. Safe to delete:
#   rm -rf work outputs
work/
outputs/

# Seeded design-canvas payload; the .dc.html sources beside it are the source
# of truth and regenerate it.
docs/design/neon-rail-ui.html

# Launch-video build. The composition stages ~60 MB of working media plus two
# Microsoft system fonts copied out of C:\Windows\Fonts for the local render --
# neither belongs in a public repo. The finished brag.mp4 and brag.jpg are the
# deliverables; commit them deliberately if you want them tracked.
brag-output/
