{
  "name": "neon-rail",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "description": "A three-lane endless runner in the browser. Three.js, no engine, no network at runtime \u2014 and it plays from your webcam.",
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "dev": "node build.mjs && node server.mjs --open",
    "test": "node tests/core-tests.mjs && node tests/motion-tests.mjs && node tests/body-tests.mjs",
    "assets:mediapipe": "node tools/stage-mediapipe.mjs"
  },
  "dependencies": {
    "three": "0.185.1",
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT",
  "keywords": [
    "game",
    "endless-runner",
    "threejs",
    "webgl",
    "mediapipe",
    "pose-detection",
    "webcam",
    "browser-game"
  ],
  "engines": {
    "node": ">=18"
  }
}
